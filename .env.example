# Token del bot Telegram, ottenuto da @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID della chat/gruppo Telegram su cui inoltrare i messaggi.
# Per i gruppi è un numero negativo (es. -1001234567890).
# Puoi ottenerlo aggiungendo temporaneamente @userinfobot al gruppo,
# oppure leggendo un update ricevuto dal bot con getUpdates.
TELEGRAM_CHAT_ID=-1001234567890

# Nome del canale Meshtastic da inoltrare (case-insensitive).
MESHTASTIC_CHANNEL_NAME=NomeCanale

# Facoltativo: chiave (PSK) del canale. Se impostata e il canale
# MESHTASTIC_CHANNEL_NAME non esiste ancora sul nodo, il bot lo crea
# automaticamente (provisioning) sul primo slot libero, con questo nome
# e questa chiave, e lo scrive sul dispositivo all'avvio.
# Se lasciata vuota, il bot NON crea nulla: si limita a cercare un canale
# già esistente con quel nome (e se non lo trova ricade sul canale 0).
# Valori accettati (stessa sintassi della CLI `meshtastic --ch-set psk`):
#   random        -> genera una chiave casuale a 256 bit
#   default       -> usa la chiave di default dei canali Meshtastic
#   none          -> nessuna cifratura
#   0x<64 hex>    -> chiave a 256 bit specificata in esadecimale
#   base64:<...>  -> chiave specificata in base64
MESHTASTIC_CHANNEL_PSK=

# Facoltativo: porta seriale fissa (es. /dev/ttyUSB0 o /dev/ttyACM0).
# Se lasciata vuota, la libreria meshtastic autorileva l'unica porta USB collegata.
MESHTASTIC_PORT=
